{
   "action": {
      "default_icon": {
         "16": "icon/icon_gray_16.png",
         "32": "icon/icon_gray_32.png"
      },
      "default_popup": "popup.html"
   },
   "author": "jasmin",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "styles.css" ],
      "js": [ "lib/jquery-3.5.1.js", "dibe.js", "common.js" ],
      "matches": [ "*://gall.dcinside.com/*" ],
      "run_at": "document_start"
   } ],
   "description": "Dcinside Integrated Broadcast Environment",
   "host_permissions": [ "*://gall.dcinside.com/*" ],
   "icons": {
      "128": "icon/icon_128.png",
      "16": "icon/icon_16.png",
      "32": "icon/icon_32.png",
      "48": "icon/icon_48.png"
   },
   "manifest_version": 3,
   "name": "DIBE_Custom",
   "permissions": [ "storage", "declarativeContent" ],
   "version": "2025.05.01.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "image/*" ]
   } ]
}
